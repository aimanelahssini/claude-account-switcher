#!/bin/bash
# What Claude Code is doing, for the top bar, the ThinkPad lights and sleep. Claude Code's hooks
# call it (install.sh adds them to ~/.claude/settings.json):
#   claude-busy busy     a session works (a prompt, a tool call)
#   claude-busy idle     a session is done
#   claude-busy needs    a session waits for you (a permission prompt or a question)
#   claude-busy ask      a permission prompt: waits for an answer from the notification
#   claude-busy answer SESSION   (the top bar) passes that answer on, read from stdin
#   claude-busy lights   puts the lights in line with the switches
#   claude-busy off-when-done on|off|now   turn the computer off once every chat has really
#                        finished (the top bar's menu); `now` skips the last minute's warning
#   claude-busy status
# Working sessions are files in $XDG_RUNTIME_DIR/claude-busy holding their claude process id;
# sessions that wait for you are in its needs/ folder, permission prompts in ask/.
# While any session works, a background `claude-busy hold` keeps two inhibitors: logind ignores
# the lid and GNOME doesn't suspend when idle. There's no time limit while Claude works. A
# session that waits for you keeps the computer awake 15 minutes, so the lights can tell you;
# after that, and a minute after the last session is done, the inhibitors go and a lid that is
# still closed suspends the computer as usual. The lid logo dot blinks with the top bar's
# spinner while Claude works with the lid closed; it and the power light blink twice and pause
# while a session waits for you.
DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/claude-busy"
HOLDER="$DIR/.holder"
ACCOUNTS="$HOME/.claude/accounts"
# The top bar's menu (or `claude-account keep-awake|lights|ask off`) creates these files.
OFF="$ACCOUNTS/keep-awake-off"
LIGHTS_OFF="$ACCOUNTS/lights-off"
ASK_OFF="$ACCOUNTS/ask-off"
# Ask on my phone (`claude-account phone`): set up, and not turned off.
PHONE="$ACCOUNTS/.phone"
PHONE_OFF="$ACCOUNTS/phone-off"
ACCOUNT_CMD=${CLAUDE_ACCOUNT_CMD:-$HOME/.local/bin/claude-account}
# Turn off when Claude is done: until the computer restarts, or you turn it off again.
OFF_WHEN_DONE="$DIR/.off-when-done"
OFF_AT="$DIR/.off-at"                         # the moment it turns off (the top bar warns you)
QUIET_SECONDS=${CLAUDE_BUSY_QUIET:-180}       # everything finished this long, not just a pause
OFF_WARN_SECONDS=${CLAUDE_BUSY_OFF_WARN:-60}
SESSIONS=${CLAUDE_SESSIONS:-$HOME/.claude/sessions}   # Claude Code's own list of its chats
WAIT_SECONDS=${CLAUDE_BUSY_WAIT:-60}        # after the last session is done, before sleep is allowed
NEEDS_SECONDS=${CLAUDE_BUSY_NEEDS:-900}     # awake for a session that waits for you
CHECK_SECONDS=${CLAUDE_BUSY_CHECK:-5}
ASK_CHECK_SECONDS=${CLAUDE_BUSY_ASK_CHECK:-60}   # a waiting permission prompt checks claude is there
LEDS=${CLAUDE_BUSY_LEDS:-/sys/class/leds}
LID=${CLAUDE_BUSY_LID:-/proc/acpi/button/lid}
# Light patterns: brightness/milliseconds pairs. In step with the top bar: the spinner's star
# is big for 6 of its 12 frames of 120 ms, and "needs you" is blink, blink, pause.
P_STEADY="255 1000 255 1000"
P_WORKING="0 360 0 0 255 720 255 0 0 360 0 0"
P_NEEDS="255 150 255 0 0 150 0 0 255 150 255 0 0 1800 0 0"

json=
# The hook's JSON from stdin (one line); id = its session, else the claude process id.
session() {
    IFS= read -r json || true
    get session_id
    id=$v
    case $id in ''|*[!A-Za-z0-9-]*) id="pid-$1" ;; esac
}

# v = the string field $1 of the hook's JSON, or empty.
get() {
    v=${json#*\"$1\":\"}
    if [ "$v" = "$json" ]; then v=; else v=${v%%\"*}; fi
}

# The claude process this hook belongs to (hooks may run through a shell).
claude_pid() {
    p=$PPID
    for _ in 1 2 3 4; do
        [ -r "/proc/$p/stat" ] || break
        read -r _ comm _ pp _ < "/proc/$p/stat"
        [ "$comm" = "(claude)" ] && { echo "$p"; return; }
        p=$pp
    done
    echo ""   # not found: no process check
}

holding() {
    [ -r "$HOLDER" ] && read -r h < "$HOLDER" && kill -0 "$h" 2>/dev/null
}

# Drop sessions whose claude process is gone (it crashed or was closed); true if any are left.
# A session you stop with Esc is done once Claude Code says it's waiting for you.
working() {
    left=1
    for f in "$DIR"/*; do
        [ -f "$f" ] || continue
        read -r p < "$f" 2>/dev/null
        if [ -n "$p" ] && [ ! -d "/proc/$p" ]; then rm -f "$f"; else left=0; fi
    done
    return $left
}

# Sessions waiting for you, the same way; true if any. With "recent", only those waiting for
# less than NEEDS_SECONDS (they keep the computer awake).
needing() {
    left=1
    for f in "$DIR"/needs/*; do
        [ -f "$f" ] || continue
        { read -r p; read -r since; } < "$f" 2>/dev/null
        if [ -n "$p" ] && [ ! -d "/proc/$p" ]; then rm -f "$f"; continue; fi
        [ "$1" = recent ] && [ $((EPOCHSECONDS - ${since:-0})) -ge "$NEEDS_SECONDS" ] && continue
        left=0
    done
    return $left
}

# Start the background holder if it isn't running (and keep-awake is on).
hold_on() {
    holding && return
    [ -e "$OFF" ] && [ "$1" != force ] && return
    set -- "$0" hold
    command -v gnome-session-inhibit > /dev/null && [ -n "$DBUS_SESSION_BUS_ADDRESS" ] &&
        set -- gnome-session-inhibit --inhibit suspend --app-id claude-code --reason "Claude is working" "$@"
    setsid -f systemd-inhibit --what=handle-lid-switch --mode=block \
        --who="Claude Code" --why="Claude is working" "$@" < /dev/null > /dev/null 2>&1
}

# This session stops waiting for you; a permission prompt still open in a notification goes.
unneed() {
    rm -f "$DIR/needs/$id"
    if [ -r "$DIR/ask/$id.pid" ]; then
        read -r a < "$DIR/ask/$id.pid" && kill "$a" 2>/dev/null
        rm -f "$DIR/ask/$id.pid" "$DIR/ask/$id.json" "$DIR/ask/$id.fifo"
    fi
}

# This session waits for you ($1: permission, question or plan).
need() {
    rm -f "$DIR/$id"
    [ -d "$DIR/needs" ] || mkdir -p -m 700 "$DIR/needs"
    if [ ! -e "$DIR/needs/$id" ]; then
        get cwd
        cwd=$v
        get transcript_path
        printf '%s\n%s\n%s\n%s\n%s\n' "$pid" "$EPOCHSECONDS" "$1" "$cwd" "$v" > "$DIR/needs/$id"
    fi
}

phone_on() {
    [ -r "$PHONE" ] && [ ! -e "$PHONE_OFF" ]
}

# The phone's helper, while it has prompts out.
phoning() {
    ph=
    [ -r "$DIR/.phone" ] && read -r ph < "$DIR/.phone"
    [ -n "$ph" ] && kill -0 "$ph" 2>/dev/null
}

# Some chat is still at it by Claude Code's own account: working, running a command, or waiting
# for you; or a command it started still runs (a background job, a monitor). Chats suspended
# with Ctrl+Z don't count.
claude_active() {
    for f in "$SESSIONS"/*.json; do
        [ -r "$f" ] || continue
        s=$(< "$f")
        p=${s#*\"pid\":}
        p=${p#"${p%%[![:space:]]*}"}
        p=${p%%[!0-9]*}
        [ -n "$p" ] && [ -r "/proc/$p/stat" ] || continue
        st=$(< "/proc/$p/stat")
        st=${st##*) }
        case ${st%% *} in T|t|Z) continue ;; esac
        status=${s#*\"status\":}
        if [ "$status" != "$s" ]; then
            status=${status#"${status%%[![:space:]]*}"}
            status=${status#\"}
            status=${status%%\"*}
            [ "$status" = idle ] || return 0
        fi
        pgrep -P "$p" -x 'bash|sh|zsh|dash|fish' > /dev/null && return 0
    done
    return 1
}

# Every chat has really finished: nothing working, nothing waiting for you, nothing running.
finished() {
    ! working && ! needing && ! claude_active
}

power_off() {
    rm -f "$OFF_WHEN_DONE" "$OFF_AT"
    if [ -n "$CLAUDE_BUSY_POWER_OFF" ]; then   # tests
        $CLAUDE_BUSY_POWER_OFF
        return
    fi
    # Like the Power Off button; if something holds the session up, the hard way a minute later.
    gnome-session-quit --power-off --no-prompt
    sleep 60
    systemctl poweroff
}

# Turn off when Claude is done, checked by the holder: finished for QUIET_SECONDS, then the top
# bar's minute of warning (Cancel / Turn off now), then off. Anything starting again on the way
# starts the wait over.
off_when_done() {
    if ! finished; then
        quiet=
        rm -f "$OFF_AT"
        return
    fi
    [ -n "$quiet" ] || quiet=$EPOCHSECONDS
    [ $((EPOCHSECONDS - quiet)) -ge "$QUIET_SECONDS" ] || return
    if [ ! -e "$OFF_AT" ]; then
        echo $((EPOCHSECONDS + OFF_WARN_SECONDS)) > "$OFF_AT"
    else
        read -r at < "$OFF_AT"
        [ "$EPOCHSECONDS" -ge "${at:-0}" ] && power_off
    fi
}

lid_closed() {
    for f in "$LID"/*/state; do
        [ -r "$f" ] || continue
        read -r _ state < "$f"
        [ "$state" = closed ] && return 0
    done
    return 1
}

# Put a pattern on one light, unless it already has it.
light() {
    L="$LEDS/tpacpi::$1"
    [ -w "$L/pattern" ] || return
    cache="$DIR/.light-$1"
    [ -r "$cache" ] && read -r was < "$cache" && [ "$was" = "$2" ] && return
    eval "pattern=\$P_${2^^}"
    if [ "$2" = steady ]; then echo 1 > "$L/repeat"; else echo -1 > "$L/repeat"; fi
    echo "$pattern" > "$L/pattern" 2>/dev/null
    echo "$2" > "$cache"
}

# The lights for what's going on now. The lid dot only speaks with the lid closed; the power
# light when a session waits for you.
lights() {
    dot=steady power=steady
    if [ ! -e "$LIGHTS_OFF" ]; then
        if needing; then
            power=needs
            lid_closed && dot=needs
        elif working && lid_closed; then
            dot=working
        fi
    fi
    light lid_logo_dot "$dot"
    light power "$power"
}

case $1 in
busy)
    pid=$(claude_pid)
    session "$pid"
    [ -d "$DIR" ] || mkdir -p -m 700 "$DIR"
    get hook_event_name
    event=$v
    get tool_name
    # A question or a plan to approve: Claude waits for you from here on.
    if [ "$event" = PreToolUse ] && { [ "$v" = AskUserQuestion ] || [ "$v" = ExitPlanMode ]; }; then
        unneed
        [ "$v" = AskUserQuestion ] && need question || need plan
    else
        unneed
        echo "$pid" > "$DIR/$id"
    fi
    hold_on
    lights
    ;;
idle)
    pid=$(claude_pid)
    session "$pid"
    get hook_event_name
    # "Waiting for your input" while a prompt is open: still waiting for you, not done.
    [ "$v" = Notification ] && [ -e "$DIR/needs/$id" ] || unneed
    rm -f "$DIR/$id"
    lights
    ;;
needs)
    pid=$(claude_pid)
    session "$pid"
    get notification_type
    [ "$v" = elicitation_dialog ] && need question || need permission
    hold_on
    lights
    ;;
ask)
    # Shown in the terminal at the same time; whichever you answer first counts. Answered in
    # the terminal, the next hook for this session ends this one (unneed).
    pid=$(claude_pid)
    session "$pid"
    need permission
    hold_on
    lights
    [ -e "$ASK_OFF" ] && ! phone_on && exit 0
    A="$DIR/ask"
    [ -d "$A" ] || mkdir -p -m 700 "$A"
    rm -f "$A/$id.fifo"
    mkfifo -m 600 "$A/$id.fifo" || exit 0
    printf '%s\n' "$json" > "$A/$id.json.tmp" && mv "$A/$id.json.tmp" "$A/$id.json"
    echo $$ > "$A/$id.pid"
    # Your phone gets it too once you're away (one helper for all prompts; it exits when done).
    phone_on && ! phoning && setsid -f "$ACCOUNT_CMD" phone run < /dev/null > /dev/null 2>&1
    trap 'rm -f "$A/$id.fifo" "$A/$id.pid" "$A/$id.json"; exit 0' TERM INT
    exec 3<> "$A/$id.fifo"
    answer=
    # Blocks without using the CPU; once a minute it checks that claude is still there.
    while :; do
        if read -t "$ASK_CHECK_SECONDS" -r answer <&3; then break; fi
        [ -n "$pid" ] && [ ! -d "/proc/$pid" ] && break
    done
    rm -f "$A/$id.fifo" "$A/$id.pid" "$A/$id.json"
    case $answer in
    '{'*)
        printf '%s\n' "$answer"
        rm -f "$DIR/needs/$id"
        echo "$pid" > "$DIR/$id"
        lights
        ;;
    esac
    ;;
answer)
    # The top bar's answer to a permission prompt (a hook decision, one line on stdin).
    id=$2
    case $id in ''|*[!A-Za-z0-9-]*) exit 2 ;; esac
    IFS= read -r line
    case $line in '{'*) ;; *) exit 2 ;; esac
    F="$DIR/ask/$id.fifo"
    [ -p "$F" ] && [ -r "$DIR/ask/$id.pid" ] || exit 1
    timeout 5 sh -c 'printf "%s\n" "$1" > "$2"' _ "$line" "$F"
    ;;
hold)
    echo $$ > "$HOLDER"
    last=$EPOCHSECONDS
    quiet=
    while :; do
        # Turning off when done: awake (lid closed too) until then, whatever else is set.
        if [ -e "$OFF_WHEN_DONE" ]; then
            off_when_done
            last=$EPOCHSECONDS
            lights
            sleep "$CHECK_SECONDS"
            continue
        fi
        quiet=
        rm -f "$OFF_AT"
        [ -e "$OFF" ] && break
        if working || needing recent; then
            last=$EPOCHSECONDS
        elif [ $((EPOCHSECONDS - last)) -ge "$WAIT_SECONDS" ]; then
            # A closed lid sleeps from here: prompts on your phone say so first.
            lid_closed && phoning && timeout 10 "$ACCOUNT_CMD" phone sleeping
            rm -f "$HOLDER"
            # Claude started again just as the waiting minute ended.
            working || needing recent || break
            echo $$ > "$HOLDER"
            last=$EPOCHSECONDS
        fi
        lights
        sleep "$CHECK_SECONDS"
    done
    rm -f "$HOLDER"
    lights
    ;;
lights)
    # After a switch in the top bar's menu.
    lights
    ;;
off-when-done)
    case $2 in
    on)
        [ -d "$DIR" ] || mkdir -p -m 700 "$DIR"
        : > "$OFF_WHEN_DONE"
        hold_on force
        ;;
    off) rm -f "$OFF_WHEN_DONE" "$OFF_AT" ;;
    now) [ -e "$OFF_AT" ] && echo 0 > "$OFF_AT" ;;
    *) if [ -e "$OFF_WHEN_DONE" ]; then echo on; else echo off; fi ;;
    esac
    ;;
status)
    if needing; then
        echo "waiting for you:"
        for f in "$DIR"/needs/*; do sed -n 3p "$f" | sed "s/^/  ${f##*/} (/;s/$/)/"; done
    fi
    if working; then
        echo "working:"
        for f in "$DIR"/*; do
            if [ -f "$f" ]; then echo "  ${f##*/}"; fi
        done
    elif holding; then
        echo "idle, staying awake for the waiting minute"
    elif ! needing; then
        echo "idle"
    fi
    ;;
*)
    echo "usage: claude-busy busy|idle|needs|ask|lights|off-when-done|status" >&2
    exit 2
    ;;
esac
