#!/usr/bin/env python3
"""Switch Claude Code between saved accounts by swapping ~/.claude/.credentials.json.

A running Claude Code session notices the credentials file changed (mtime) and
uses the new login on its next request, so the current chat just continues.

  claude-account init [NAMES]     save the current Claude Code login (as the first NAME, else "1")
  claude-account list             show accounts and which ones are signed in
  claude-account current          print the active account
  claude-account switch N         make account N active
  claude-account add N            sign in to account N in the browser
      --private                   ...in a private window, so the browser can't reuse another login
      --switch                    ...and switch to it afterwards
      --current                   save the account Claude Code is logged into now, no browser
  claude-account rename OLD NEW   rename an account (any name: 2, work, -, ...)
  claude-account remove N         forget account N's login
  claude-account usage            fetch 5-hour usage % for every account into accounts/usage.cache
  claude-account history [N]      recent 5-hour windows and how high each went
  claude-account auto-switch on|off   at 100% of the 5-hour limit, switch to the account
                                  with the most room left (on by default)
  claude-account limit-hit TRANSCRIPT  a chat stopped at the usage limit (claude-busy calls this):
                                  mark the account full and auto-switch right away
  claude-account keep-awake on|off    keep the computer awake while Claude works, lid closed
                                  too (claude-busy; on by default)
  claude-account ask on|off           permission prompts as notifications too (on by default)
  claude-account lights on|off        blink the ThinkPad lights (after install-lights.sh; on)
  claude-account phone            set up "Ask on my phone": permission prompts in Telegram, with
                                  the terminal's options, while the lid is closed or the screen locked
  claude-account phone on|off|test    turn it on or off, or send yourself a test prompt
"""
import datetime, fcntl, json, os, shutil, signal, subprocess, sys, tempfile, time, urllib.request

HOME = os.path.expanduser("~")
CLAUDE_DIR = os.path.join(HOME, ".claude")
CREDS = os.path.join(CLAUDE_DIR, ".credentials.json")
CONFIG = os.path.join(HOME, ".claude.json")
SLOTS = os.path.join(CLAUDE_DIR, "accounts")
ACTIVE = os.path.join(SLOTS, "active")
NAMES = os.path.join(SLOTS, "names")
REFRESH_LOCK = os.path.join(CLAUDE_DIR, ".oauth_refresh.lock")
USAGE_CACHE = os.path.join(SLOTS, "usage.cache")
# One JSON line per reading or switch: {"t", "a", "pct", "reset"} or {"t", "switch"}.
HISTORY = os.path.join(SLOTS, "history.jsonl")
HISTORY_DAYS = 30
HISTORY_EVERY = 600  # record an unchanged reading at most every 10 minutes
LOCK = os.path.join(SLOTS, ".lock")
# Options are on unless these files exist (the top bar's right-click menu toggles them).
OPTION_OFF = {"auto-switch": os.path.join(SLOTS, "auto-switch-off"),
              "keep-awake": os.path.join(SLOTS, "keep-awake-off"),
              "ask": os.path.join(SLOTS, "ask-off"),
              "lights": os.path.join(SLOTS, "lights-off"),
              "phone": os.path.join(SLOTS, "phone-off")}
WINDOW_JITTER = 600  # the API's reset time wobbles by a second or so between readings
# Tokens per account (tokens.cache), from Claude Code's own transcripts on this computer, in 10-minute steps:
# {"step": 600, "accounts": {name: {step start: [tokens, cache reads]}}}. "tokens" is input +
# output + cache writes; cache reads are kept apart since they're cheap and huge.
TOKENS = os.path.join(SLOTS, "tokens.cache")  # not .json: those are accounts
TOKENS_STATE = os.path.join(SLOTS, ".tokens-state")  # how far each transcript was read
TOKENS_STEP = 600
TOKENS_DAYS = 8
PROJECTS = os.path.join(CLAUDE_DIR, "projects")
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
# Ask on my phone: your own Telegram bot's token and your chat with it ({"token", "chat"}).
PHONE = os.path.join(SLOTS, ".phone")
PHONE_API = os.environ.get("CLAUDE_PHONE_API", "https://api.telegram.org")  # tests use a stand-in
BUSY_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "claude-busy")
ASK_DIR = os.path.join(BUSY_DIR, "ask")
PHONE_PID = os.path.join(BUSY_DIR, ".phone")
BUSY_CMD = os.environ.get("CLAUDE_BUSY_CMD") or os.path.join(HOME, ".local", "bin", "claude-busy")
LID = os.environ.get("CLAUDE_BUSY_LID", "/proc/acpi/button/lid")


def read_json(path):
    with open(path) as f:
        return json.load(f)


def write_json(path, data, mode=0o600):
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def slot_path(n):
    return os.path.join(SLOTS, f"{n}.json")


def slots():
    os.makedirs(SLOTS, mode=0o700, exist_ok=True)
    return sorted(f[:-5] for f in os.listdir(SLOTS) if f.endswith(".json") and not f.startswith("."))


def names():
    """Account names in display order: the names file, then any other saved slot."""
    try:
        listed = [l.strip() for l in open(NAMES) if l.strip()]
    except FileNotFoundError:
        listed = []
    return listed + [n for n in slots() if n not in listed]


def set_names(new):
    new = list(dict.fromkeys(new))  # no duplicates, order kept
    os.makedirs(SLOTS, mode=0o700, exist_ok=True)
    with open(NAMES + ".tmp", "w") as f:
        f.write("".join(f"{n}\n" for n in new))
    os.replace(NAMES + ".tmp", NAMES)


def current():
    try:
        return open(ACTIVE).read().strip() or None
    except FileNotFoundError:
        return None


def set_active(n):
    with open(ACTIVE + ".tmp", "w") as f:
        f.write(f"{n}\n")
    os.replace(ACTIVE + ".tmp", ACTIVE)


def save_live_into(n):
    """Store the live login (with any tokens Claude refreshed meanwhile) into slot n."""
    slot = read_json(slot_path(n)) if os.path.exists(slot_path(n)) else {}
    slot["credentials"] = read_json(CREDS)
    acct = read_json(CONFIG).get("oauthAccount")
    # Only take oauthAccount if it still belongs to this slot (a running session may not
    # have rewritten it yet after a switch).
    if acct and (not slot.get("oauthAccount") or
                 acct.get("accountUuid") == slot["oauthAccount"].get("accountUuid")):
        slot["oauthAccount"] = acct
    write_json(slot_path(n), slot)


def locked():
    os.makedirs(SLOTS, mode=0o700, exist_ok=True)
    f = open(LOCK, "w")
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


def http_json(url, data=None, token=None):
    headers = {"User-Agent": "claude-account", "Content-Type": "application/json"}
    if token:
        headers |= {"Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"}
    body = json.dumps(data).encode() if data is not None else None
    with urllib.request.urlopen(urllib.request.Request(url, body, headers), timeout=15) as r:
        return json.load(r)


def refresh_slot(n, slot):
    """Renew an inactive slot's expired access token (the live one is Claude's job)."""
    oauth = slot["credentials"]["claudeAiOauth"]
    r = http_json(TOKEN_URL, {"grant_type": "refresh_token", "client_id": CLIENT_ID,
                              "refresh_token": oauth["refreshToken"],
                              "scope": " ".join(oauth.get("scopes", []))})
    oauth["accessToken"] = r["access_token"]
    oauth["refreshToken"] = r.get("refresh_token", oauth["refreshToken"])
    oauth["expiresAt"] = int((time.time() + r["expires_in"]) * 1000)
    write_json(slot_path(n), slot)


def read_history():
    out = []
    try:
        with open(HISTORY) as f:
            for line in f:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    pass
    except FileNotFoundError:
        pass
    return out


def append_history(entries):
    if not entries:
        return
    with open(HISTORY, "a") as f:
        for e in entries:
            f.write(json.dumps(e, separators=(",", ":")) + "\n")
    if os.path.getsize(HISTORY) > 512 * 1024:  # prune now and then
        cutoff = time.time() - HISTORY_DAYS * 86400
        keep = [e for e in read_history() if e.get("t", 0) >= cutoff]
        tmp = HISTORY + ".tmp"
        with open(tmp, "w") as f:
            f.writelines(json.dumps(e, separators=(",", ":")) + "\n" for e in keep)
        os.replace(tmp, HISTORY)


def reset_time(reset):
    try:
        return datetime.datetime.fromisoformat(reset.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        return None


def same_window(a, b):
    ta, tb = reset_time(a), reset_time(b)
    return ta is not None and tb is not None and abs(ta - tb) < WINDOW_JITTER


def record_readings(out):
    """Add fresh readings to the history: on any change, else every HISTORY_EVERY seconds."""
    last = {}
    for e in read_history()[-200:]:
        if "a" in e:
            last[e["a"]] = e
    now = int(time.time())
    new = []
    for n, u in out.items():
        if n.startswith("_") or u.get("stale") or not isinstance(u.get("pct"), (int, float)):
            continue
        prev = last.get(n)
        if prev and prev.get("pct") == u["pct"] and same_window(prev.get("reset"), u.get("resets_at")) \
                and now - prev["t"] < HISTORY_EVERY:
            continue
        new.append({"t": now, "a": n, "pct": u["pct"], "reset": u.get("resets_at")})
    append_history(new)


def windows(name, days=7):
    """5-hour windows of one account, newest first: (start, end, peak %)."""
    cutoff = time.time() - days * 86400
    ends = sorted((reset_time(e.get("reset")), e["pct"]) for e in read_history()
                  if e.get("a") == name and e["t"] >= cutoff and reset_time(e.get("reset")))
    # Readings of one window are a second or so apart in reset time; windows are hours apart.
    groups = []
    for end, pct in ends:
        if groups and end - groups[-1][0] < WINDOW_JITTER:
            groups[-1][1] = max(groups[-1][1], pct)
        else:
            groups.append([end, pct])
    rounded = ((round(end / 60) * 60, peak) for end, peak in groups)
    return sorted(((end - 5 * 3600, end, peak) for end, peak in rounded), reverse=True)


def account_at(switches, t):
    """The account that was active at time t, from the switches in the history."""
    who = None
    for st, n in switches:
        if st > t:
            break
        who = n
    if who is None and not switches:
        who = current()
    return who


def index_tokens():
    """Add what Claude Code's transcripts gained since last time to tokens.cache."""
    try:
        state = read_json(TOKENS_STATE)
    except (FileNotFoundError, ValueError):
        state = {}
    try:
        data = read_json(TOKENS)
    except (FileNotFoundError, ValueError):
        data = {}
    files, seen = state.get("files", {}), state.get("seen", [])
    seen_set = set(seen)
    accounts = data.get("accounts", {})
    switches = [(e["t"], e["switch"]) for e in read_history() if "switch" in e]
    cutoff = time.time() - TOKENS_DAYS * 86400
    new_files = {}
    for root, _, names_ in os.walk(PROJECTS):
        for fn in names_:
            if not fn.endswith(".jsonl"):
                continue
            path = os.path.join(root, fn)
            try:
                st = os.stat(path)
            except OSError:
                continue
            if st.st_mtime < cutoff:
                continue
            offset, ino = files.get(path, [0, st.st_ino])
            if ino != st.st_ino or st.st_size < offset:
                offset = 0
            if st.st_size > offset:
                with open(path, "rb") as f:
                    f.seek(offset)
                    chunk = f.read(st.st_size - offset)
                end = chunk.rfind(b"\n") + 1  # a line still being written waits for next time
                for line in chunk[:end].splitlines():
                    if b'"usage"' not in line or b'"assistant"' not in line:
                        continue
                    try:
                        e = json.loads(line)
                        msg = e["message"]
                        u = msg["usage"]
                        t = datetime.datetime.fromisoformat(e["timestamp"].replace("Z", "+00:00")).timestamp()
                    except (ValueError, KeyError, TypeError, AttributeError):
                        continue
                    key = msg.get("id") or e.get("requestId")
                    if t < cutoff or not key or key in seen_set:
                        continue  # Claude Code writes one line per content block, same usage
                    seen_set.add(key)
                    seen.append(key)
                    who = account_at(switches, t)
                    if who is None:
                        continue
                    bucket = str(int(t // TOKENS_STEP * TOKENS_STEP))
                    slot = accounts.setdefault(who, {}).setdefault(bucket, [0, 0])
                    slot[0] += sum(u.get(k) or 0 for k in ("input_tokens", "output_tokens", "cache_creation_input_tokens"))
                    slot[1] += u.get("cache_read_input_tokens") or 0
                offset += end
            new_files[path] = [offset, st.st_ino]
    for buckets in accounts.values():
        for b in [b for b in buckets if int(b) < cutoff]:
            del buckets[b]
    write_json(TOKENS, {"step": TOKENS_STEP, "accounts": accounts}, mode=0o600)
    write_json(TOKENS_STATE, {"files": new_files, "seen": seen[-5000:]}, mode=0o600)
    return accounts


def tokens_between(accounts, name, start, end):
    return sum(v[0] for b, v in accounts.get(name, {}).items() if start <= int(b) < end)


def short(n):
    for div, unit in ((1e9, "B"), (1e6, "M"), (1e3, "k")):
        if n >= div:
            v = n / div
            return (f"{v:.1f}".rstrip("0").rstrip(".") if v < 10 else f"{v:.0f}") + unit
    return str(int(n))


def history(name=None):
    for n in ([name] if name else names()):
        print(f"{n}:")
        rows = windows(n)
        if not rows:
            print("  no history yet (it's recorded from the first usage check on)")
        try:
            accounts = read_json(TOKENS).get("accounts", {})
        except (FileNotFoundError, ValueError):
            accounts = {}
        for start, end, peak in rows[:10]:
            s, e = datetime.datetime.fromtimestamp(start), datetime.datetime.fromtimestamp(end)
            bar = "█" * round(peak / 10) + "·" * (10 - round(peak / 10))
            tokens = tokens_between(accounts, n, start, end)
            now = "  now" if start <= time.time() < end else ""
            print(f"  {s:%a %d %b %H:%M}–{e:%H:%M}  {bar} {peak:3.0f}%"
                  f"{f'  {short(tokens)} tokens' if tokens else ''}{now}")


def usage():
    cur = current()
    try:
        previous = read_json(USAGE_CACHE)
    except (FileNotFoundError, ValueError):
        previous = {}
    out = {}
    for n in slots():
        try:
            with locked():
                slot = read_json(slot_path(n))
                if n == cur:
                    oauth = read_json(CREDS)["claudeAiOauth"]
                    # Claude Code renews the live token itself on its next request; until
                    # then keep showing the last numbers rather than a failed lookup.
                    if oauth["expiresAt"] / 1000 < time.time() and previous.get(n, {}).get("pct") is not None:
                        out[n] = dict(previous[n], stale=True)
                        continue
                else:
                    oauth = slot["credentials"]["claudeAiOauth"]
                    if oauth["expiresAt"] / 1000 < time.time() + 60:
                        refresh_slot(n, slot)
                token = oauth["accessToken"]
            five = http_json(USAGE_URL, token=token).get("five_hour") or {}
            out[n] = {"pct": five.get("utilization"), "resets_at": five.get("resets_at")}
        except Exception as e:
            last = previous.get(n, {})
            out[n] = dict(last, stale=True, error=str(e)[:200]) if last.get("pct") is not None \
                else {"pct": None, "error": str(e)[:200]}
    out["_at"] = int(time.time())
    try:
        record_readings(out)
    except OSError:
        pass
    try:
        index_tokens()
    except OSError:
        pass
    with open(USAGE_CACHE + ".tmp", "w") as f:
        json.dump(out, f)
    os.replace(USAGE_CACHE + ".tmp", USAGE_CACHE)
    for n in slots():
        print(n, out[n].get("pct"), out[n].get("error", ""))
    if option("auto-switch"):
        auto_switch(cur, out)


def option(name):
    return not os.path.exists(OPTION_OFF[name])


def set_option(name, on):
    if on:
        try:
            os.remove(OPTION_OFF[name])
        except FileNotFoundError:
            pass
    else:
        open(OPTION_OFF[name], "w").close()


def roomiest(cur, out):
    """The signed-in account with the most room left: a fresh reading first, then one kept from
    before (the usage check can be refused for a while), and an ended window counts as empty."""
    now = time.time()
    room = []
    for i, n in enumerate(slots()):
        u = out.get(n) or {}
        if n == cur or not isinstance(u.get("pct"), (int, float)):
            continue
        if (reset_time(u.get("resets_at")) or now + 1) <= now:
            room.append((0, 0, i, n))
        elif u["pct"] < 100:
            room.append((1 if u.get("stale") else 0, u["pct"], i, n))
    return min(room)[3] if room else None


def auto_switch(cur, out):
    """The active account is at its 5-hour limit: move to the signed-in one with the most room."""
    now = time.time()
    u = out.get(cur) or {}
    if not isinstance(u.get("pct"), (int, float)) or u["pct"] < 100:
        return
    # A kept (stale) reading still counts while its window lasts.
    if u.get("stale") and (reset_time(u.get("resets_at")) or 0) < now:
        return
    target = roomiest(cur, out)
    if not target:
        return
    with locked():
        if current() != cur:
            return
        switch(target, auto=True)
    print(f"auto-switched {cur} -> {target}")


def limit_stop(transcript):
    """(when, resets at) of the usage-limit error a chat just stopped on, else None. Claude
    Code may write it just after the StopFailure hook starts, so look again for a moment."""
    for _ in range(10):
        try:
            with open(transcript, "rb") as f:
                f.seek(max(0, os.fstat(f.fileno()).st_size - 65536))
                lines = f.read().splitlines()
        except OSError:
            return None
        for line in reversed(lines):
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get("type") not in ("assistant", "user"):
                continue
            if e.get("apiError") != "usage_limit_reached":
                break
            info = (e.get("apiErrorParams") or {}).get("rate_limit_info") or {}
            when = reset_time(e.get("timestamp")) or time.time()
            return when, info.get("resetsAt")
        time.sleep(0.3)
    return None


def limit_hit(transcript):
    """A chat stopped at the active account's limit: that account is at 100% whatever the last
    usage check said, so switch now instead of after the next check (which may be refused)."""
    hit = limit_stop(transcript)
    if not hit:
        return
    when, resets = hit
    with locked():
        cur = current()
        last_switch = max((h["t"] for h in read_history() if "switch" in h), default=0)
        # It stopped on the account used before the last switch: already handled. (History times
        # are whole seconds; a stop on the new account comes well over a second later.)
        if not cur or when < last_switch + 1:
            return
        try:
            out = read_json(USAGE_CACHE)
        except (FileNotFoundError, ValueError):
            out = {}
        u = out.get(cur) or {}
        reset = datetime.datetime.fromtimestamp(resets, datetime.timezone.utc).isoformat() \
            if isinstance(resets, (int, float)) else u.get("resets_at")
        out[cur] = {"pct": 100.0, "resets_at": reset}
        with open(USAGE_CACHE + ".tmp", "w") as f:
            json.dump(out, f)
        os.replace(USAGE_CACHE + ".tmp", USAGE_CACHE)
        target = roomiest(cur, out) if option("auto-switch") else None
        if target:
            switch(target, auto=True)
            print(f"auto-switched {cur} -> {target}")


def wait_for_refresh_lock():
    for _ in range(50):
        if not os.path.exists(REFRESH_LOCK):
            return
        time.sleep(0.2)


def switch(n, auto=False):
    if not os.path.exists(slot_path(n)):
        sys.exit(f"account {n} is not signed in; run: claude-account add {n}")
    cur = current()
    if cur == n:
        return
    wait_for_refresh_lock()
    if cur and os.path.exists(slot_path(cur)) and os.path.exists(CREDS):
        save_live_into(cur)
    target = read_json(slot_path(n))
    write_json(CREDS, target["credentials"])
    if target.get("oauthAccount"):
        cfg = read_json(CONFIG)
        cfg["oauthAccount"] = target["oauthAccount"]
        write_json(CONFIG, cfg, mode=os.stat(CONFIG).st_mode & 0o777)
    set_active(n)
    append_history([dict({"t": int(time.time()), "switch": n}, **({"auto": cur} if auto else {}))])


# Private-window flags for browsers, keyed by a word in their .desktop id.
PRIVATE_BROWSERS = [
    ("firefox", ["firefox", "--private-window"], "org.mozilla.firefox"),
    ("librewolf", ["librewolf", "--private-window"], "io.gitlab.librewolf-community"),
    ("chromium", ["chromium-browser", "--incognito"], "org.chromium.Chromium"),
    ("chrome", ["google-chrome", "--incognito"], "com.google.Chrome"),
    ("brave", ["brave-browser", "--incognito"], "com.brave.Browser"),
    ("edge", ["microsoft-edge", "--inprivate"], "com.microsoft.Edge"),
]


def private_browser():
    """Command that opens a URL in a private window of the default browser (or None)."""
    try:
        default = subprocess.run(["xdg-settings", "get", "default-web-browser"],
                                 capture_output=True, text=True).stdout.lower()
    except FileNotFoundError:
        default = ""
    ordered = sorted(PRIVATE_BROWSERS, key=lambda b: b[0] not in default)
    for _, cmd, flatpak_id in ordered:
        if shutil.which(cmd[0]):
            return cmd
        if shutil.which("flatpak") and subprocess.run(
                ["flatpak", "info", flatpak_id], capture_output=True).returncode == 0:
            return ["flatpak", "run", flatpak_id] + cmd[1:]
    return None


def add(n, use_current, private=False):
    slots()
    if n not in names():
        set_names(names() + [n])
    if use_current:
        write_json(slot_path(n), {"credentials": read_json(CREDS),
                                  "oauthAccount": read_json(CONFIG).get("oauthAccount")})
        set_active(n)
        print(f"saved the current login as account {n}")
        return
    tmp = tempfile.mkdtemp(prefix="claude-login-")
    try:
        env = dict(os.environ, CLAUDE_CONFIG_DIR=tmp)
        if private:
            cmd = private_browser()
            if cmd:
                opener = os.path.join(tmp, "open-private")
                with open(opener, "w") as f:
                    f.write("#!/bin/sh\nexec " + " ".join(cmd) + ' "$1"\n')
                os.chmod(opener, 0o700)
                env["BROWSER"] = opener
                print(f"Opening the sign-in page in a private window ({cmd[-2] if cmd[0] == 'flatpak' else cmd[0]})...", flush=True)
            else:
                print("No browser with a private mode found; using the normal browser.", flush=True)
        try:
            subprocess.run(["claude", "auth", "login"], env=env, check=True)
            creds = read_json(os.path.join(tmp, ".credentials.json"))
        except (subprocess.CalledProcessError, FileNotFoundError, KeyboardInterrupt):
            sys.exit("login not completed; nothing saved")
        acct = read_json(os.path.join(tmp, ".claude.json")).get("oauthAccount")
        write_json(slot_path(n), {"credentials": creds, "oauthAccount": acct})
        print(f"signed in as {acct and acct.get('emailAddress')}, saved as account {n}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def remove(n):
    if current() == n:
        sys.exit(f"{n} is the active account; switch to another one first")
    if os.path.exists(slot_path(n)):
        os.remove(slot_path(n))
    print(f"forgot the login for {n}")


def rename(old, new):
    if old not in names():
        sys.exit(f"no account named {old}")
    if new in names():
        sys.exit(f"there's already an account named {new}")
    if not new or "/" in new or new.startswith("."):
        sys.exit("pick a name without '/' that doesn't start with '.'")
    with locked():
        order = names()  # read before moving the file, or the moved login looks like an extra account
        if os.path.exists(slot_path(old)):
            os.replace(slot_path(old), slot_path(new))
        set_names([new if n == old else n for n in order])
        hist = read_history()
        if any(e.get("a") == old or e.get("switch") == old for e in hist):
            for e in hist:
                if e.get("a") == old:
                    e["a"] = new
                if e.get("switch") == old:
                    e["switch"] = new
            tmp = HISTORY + ".tmp"
            with open(tmp, "w") as f:
                f.writelines(json.dumps(e, separators=(",", ":")) + "\n" for e in hist)
            os.replace(tmp, HISTORY)
        if current() == old:
            set_active(new)
        try:
            cache = read_json(USAGE_CACHE)
            if old in cache:
                cache[new] = cache.pop(old)
                write_json(USAGE_CACHE, cache, mode=0o644)
        except (FileNotFoundError, ValueError):
            pass
    print(f"renamed {old} to {new}")


def init(new_names):
    """Installer entry point: names come from the user, so only the current login is saved."""
    if new_names and not os.path.exists(NAMES):
        set_names(new_names)
    if not slots() and os.path.exists(CREDS):
        add((names() or ["1"])[0], use_current=True)
    if names():
        print("accounts: " + "  ".join(names()))
    print("Add an account with the + in the top bar, or: claude-account add NAME --private")
    print("Rename one with: claude-account rename OLD NEW")


# ---- Ask on my phone ----------------------------------------------------------------------
# While a permission prompt waits and you're away (lid closed or screen locked), your own
# Telegram bot sends it to you with the terminal's options as buttons. A tap answers Claude
# (through claude-busy, like the top bar's notification); answered elsewhere, or when the laptop
# goes to sleep, the message loses its buttons and says so. One `phone run` serves every
# waiting prompt (Telegram allows one listener per bot) and exits when none are left.

def telegram(method, token, **params):
    body = json.dumps(params).encode()
    req = urllib.request.Request(f"{PHONE_API}/bot{token}/{method}", body, {"Content-Type": "application/json"})
    timeout = params.get("timeout", 0) + 15
    with urllib.request.urlopen(req, timeout=timeout) as r:
        out = json.load(r)
    if not out.get("ok"):
        raise RuntimeError(out.get("description", "Telegram said no"))
    return out["result"]


def phone_config():
    try:
        cfg = read_json(PHONE)
        return cfg if cfg.get("token") and cfg.get("chat") else None
    except (FileNotFoundError, ValueError):
        return None


def away():
    """The lid is closed or the screen is locked."""
    try:
        for name in os.listdir(LID):
            with open(os.path.join(LID, name, "state")) as f:
                if f.read().split()[-1] == "closed":
                    return True
    except (OSError, IndexError):
        pass
    forced = os.environ.get("CLAUDE_BUSY_LOCKED")  # tests
    if forced is not None:
        return forced == "1"
    try:
        out = subprocess.run(["gdbus", "call", "--session", "--dest", "org.gnome.ScreenSaver", "--object-path",
                              "/org/gnome/ScreenSaver", "--method", "org.gnome.ScreenSaver.GetActive"],
                             capture_output=True, text=True, timeout=3).stdout
        return "true" in out
    except (OSError, subprocess.SubprocessError):
        return False


def html(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def home_short(path):
    return "~" + path[len(HOME):] if path and (path == HOME or path.startswith(HOME + "/")) else path or ""


def prompt_options(request):
    """The terminal's options for this prompt: [(label, decision)]. Claude Code's own wording;
    its "switch to auto mode" is left out (a mode, not an answer). A question's options are
    Claude's own choices (one question with one pick only: more doesn't fit chat buttons). A
    plan has none: Claude Code takes its approval only in the chat."""
    tool, inp = request.get("tool_name"), request.get("tool_input") or {}
    if tool == "AskUserQuestion":
        qs = inp.get("questions") or []
        if len(qs) != 1 or qs[0].get("multiSelect"):
            return []
        q = qs[0]
        return [(o.get("label", ""), {"behavior": "allow", "updatedInput": {**inp, "answers": {q.get("question", ""): o.get("label", "")}}})
                for o in q.get("options") or []]
    if tool == "ExitPlanMode":
        return []   # Claude Code takes a plan's approval only in the chat itself
    suggestions = [x for x in request.get("permission_suggestions") or [] if x.get("type") != "setMode"]
    rules = [r.get("ruleContent") or r.get("toolName", "") for x in suggestions if x.get("type") == "addRules"
             for r in x.get("rules", [])]
    rules = [r[:-2] if r.endswith(":*") else r for r in rules]
    dirs = [home_short(d) for x in suggestions if x.get("type") == "addDirectories" for d in x.get("directories", [])]
    options = [("Yes", {"behavior": "allow"})]
    always = None
    if rules and not dirs:
        always = f"Yes, and don't ask again for {', '.join(rules)} commands in {home_short(request.get('cwd', ''))}"
    elif dirs and not rules:
        always = f"Yes, and always allow access to {', '.join(dirs)} from this project"
    elif dirs and rules:
        always = (f"Yes, and allow access to {dirs[0]} and {rules[0]} commands" if len(dirs) == 1 and len(rules) == 1
                  else f"Yes, and allow {', '.join(dirs)} access and {', '.join(rules)} commands")
    if always:
        options.append((always, {"behavior": "allow", "updatedPermissions": suggestions}))
    options.append(("No", {"behavior": "deny", "message": "The user said no (from their phone).", "interrupt": True}))
    return options


def prompt_text(request):
    """The prompt as the terminal shows it, for Telegram (HTML)."""
    tool, inp = request.get("tool_name", ""), request.get("tool_input") or {}
    cwd = request.get("cwd") or HOME
    project = os.path.basename(cwd) if cwd != HOME else "Claude Code"
    if tool == "AskUserQuestion":
        lines = [f"<b>{html(project)}</b>"]
        for q in inp.get("questions") or []:
            lines += ["", f"<b>{html(q.get('header', ''))}</b> {html(q.get('question', ''))}".strip()]
            for i, o in enumerate(q.get("options") or [], 1):
                lines.append(f"{i}. {html(o.get('label', ''))}" + (f" — <i>{html(o['description'])}</i>" if o.get("description") else ""))
        if not prompt_options(request):
            lines += ["", "<i>Several questions or choices: answer on the laptop.</i>"]
        return "\n".join(lines)
    if tool == "ExitPlanMode":
        return "\n".join([f"<b>{html(project)}</b>", "<b>Ready to code?</b>", "Here is Claude's plan:",
                          f"<pre>{html(inp.get('plan', '')[:2500])}</pre>",
                          "<i>Approve it on the laptop: Claude Code only takes a plan's approval in the chat.</i>"])
    if tool == "Bash":
        title, body = "Bash command", [f"<pre>{html(inp.get('command', ''))}</pre>", html(inp.get("description", ""))]
    elif tool in ("Edit", "MultiEdit", "Write", "NotebookEdit"):
        path = inp.get("file_path") or inp.get("notebook_path") or ""
        change = inp.get("new_string") or inp.get("content") or inp.get("new_source") or ""
        preview = "\n".join(change.splitlines()[:12])
        title, body = ("Create file" if tool == "Write" and not os.path.exists(path) else "Edit file"), \
            [f"<code>{html(home_short(path))}</code>"] + ([f"<pre>{html(preview)}</pre>"] if preview else [])
    elif tool == "Read":
        title, body = "Read file", [f"<code>{html(home_short(inp.get('file_path', '')))}</code>"]
    elif tool == "WebFetch":
        title, body = "Fetch", [html(inp.get("url", ""))]
    elif tool == "WebSearch":
        title, body = "Web search", [html(inp.get("query", ""))]
    else:
        title, body = tool, [f"<pre>{html(json.dumps(inp, indent=1)[:600])}</pre>"]
    options = "\n".join(f"{i}. {html(label)}" for i, (label, _) in enumerate(prompt_options(request), 1))
    return "\n".join([f"<b>{html(project)}</b>", f"<b>{html(title)}</b>", *[b for b in body if b],
                      "", "Do you want to proceed?", options])


def phone_running():
    try:
        with open(PHONE_PID) as f:
            os.kill(int(f.read()), 0)
        return True
    except (OSError, ValueError):
        return False


def phone_run():
    """Serves every waiting prompt: sends it when you're away, waits for your tap, updates it."""
    cfg = phone_config()
    if not cfg or phone_running():
        return
    with open(PHONE_PID, "w") as f:
        f.write(f"{os.getpid()}\n")
    token, chat = cfg["token"], cfg["chat"]
    sent = {}       # session -> {"message", "nonce", "text", "options"}
    offset = None

    def sleeping(*_):
        raise SystemExit("sleeping")
    signal.signal(signal.SIGTERM, sleeping)   # `phone sleeping`: the laptop is about to sleep
    try:
        while True:
            waiting = {n[:-5] for n in os.listdir(ASK_DIR) if n.endswith(".json")} if os.path.isdir(ASK_DIR) else set()
            # Answered in the terminal or the desktop notification (or the chat went away).
            for sid in [s for s in sent if s not in waiting]:
                m = sent.pop(sid)
                edit(token, chat, m, "✓ Answered on the laptop")
            # New prompts go out once you're away.
            new = [s for s in waiting if s not in sent]
            if new and away():
                for sid in new:
                    try:
                        request = read_json(os.path.join(ASK_DIR, f"{sid}.json"))
                    except (OSError, ValueError):
                        continue
                    nonce = os.urandom(6).hex()
                    options = prompt_options(request)
                    text = prompt_text(request)
                    keyboard = [[{"text": f"{i}. {label}", "callback_data": f"{nonce}:{i}"}]
                                for i, (label, _) in enumerate(options, 1)]
                    extra = {"reply_markup": {"inline_keyboard": keyboard}} if keyboard else {}
                    msg = telegram("sendMessage", token, chat_id=chat, text=text, parse_mode="HTML", **extra)
                    sent[sid] = {"message": msg["message_id"], "nonce": nonce, "text": text, "options": options}
            if not waiting and not sent:
                return
            if not sent:
                time.sleep(2)
                continue
            # Your taps (long polling: Telegram answers at once when you tap).
            try:
                updates = telegram("getUpdates", token, timeout=10, offset=offset, allowed_updates=["callback_query"])
            except (OSError, RuntimeError):
                time.sleep(3)
                continue
            for u in updates:
                offset = u["update_id"] + 1
                q = u.get("callback_query") or {}
                nonce, _, pick = (q.get("data") or "").partition(":")
                sid = next((s for s, m in sent.items() if m["nonce"] == nonce), None)
                # Only your chat's taps, on a prompt that's still waiting.
                if str(q.get("from", {}).get("id")) != str(chat) or sid is None or not pick.isdigit():
                    if q.get("id"):
                        telegram("answerCallbackQuery", token, callback_query_id=q["id"], text="This prompt is gone")
                    continue
                m = sent.pop(sid)
                label, decision = m["options"][int(pick) - 1]
                answer = {"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision}}
                done = subprocess.run([BUSY_CMD, "answer", sid], input=json.dumps(answer) + "\n", text=True).returncode == 0
                telegram("answerCallbackQuery", token, callback_query_id=q["id"])
                edit(token, chat, m, f"✓ {pick}. {label}" if done else "✓ Answered on the laptop")
    except SystemExit:
        # Your taps can't reach it while it sleeps: the messages say so, without their buttons.
        for m in sent.values():
            edit(token, chat, m, "The laptop went to sleep. Open it to answer.")
    finally:
        try:
            os.remove(PHONE_PID)
        except OSError:
            pass


def edit(token, chat, m, status):
    """The sent prompt without its buttons, with what became of it."""
    try:
        telegram("editMessageText", token, chat_id=chat, message_id=m["message"], parse_mode="HTML",
                 text=f"{m['text']}\n\n<b>{html(status)}</b>")
    except (OSError, RuntimeError):
        pass


def phone_sleeping():
    """The laptop is about to sleep: prompts sent to the phone can't be answered from there now."""
    cfg = phone_config()
    if not cfg:
        return
    try:
        with open(PHONE_PID) as f:
            pid = int(f.read())
        os.kill(pid, signal.SIGTERM)
    except (OSError, ValueError):
        return
    # Its messages are updated before the laptop goes to sleep.
    for _ in range(80):
        if not os.path.exists(PHONE_PID):
            return
        time.sleep(0.1)


def phone_setup():
    print("Ask on my phone: permission prompts in Telegram while you're away from the laptop.\n")
    print("1. In Telegram, open @BotFather, send /newbot and pick a name and a username.")
    token = input("2. Paste the token it gives you here: ").strip()
    try:
        me = telegram("getMe", token)
    except (OSError, RuntimeError) as e:
        sys.exit(f"That token didn't work ({e}).")
    print(f"3. Now open t.me/{me['username']} on your phone and press Start (waiting 3 minutes)...")
    offset, deadline = None, time.time() + 180
    while time.time() < deadline:
        for u in telegram("getUpdates", token, timeout=20, offset=offset):
            offset = u["update_id"] + 1
            msg = u.get("message") or {}
            if msg.get("text", "").startswith("/start"):
                chat = msg["chat"]["id"]
                write_json(PHONE, {"token": token, "chat": chat}, mode=0o600)
                set_option("phone", True)
                telegram("getUpdates", token, offset=offset, timeout=0)
                telegram("sendMessage", token, chat_id=chat,
                         text="Connected. When Claude needs you and the laptop's lid is closed or its screen locked, "
                              "it asks you here.")
                print("Connected. Try it with: claude-account phone test")
                return
    sys.exit("No /start came in. Run claude-account phone again.")


def phone_test():
    cfg = phone_config()
    if not cfg:
        sys.exit("Not set up yet: run claude-account phone")
    request = {"tool_name": "Bash", "cwd": os.path.join(HOME, "Projects", "example"),
               "tool_input": {"command": "rm -f pezei.py", "description": "Delete pezei.py"},
               "permission_suggestions": [{"type": "addRules", "rules": [{"toolName": "Bash", "ruleContent": "rm -f pezei.py"}],
                                           "behavior": "allow", "destination": "localSettings"}]}
    options = prompt_options(request)
    text = "<i>A test, nothing will run.</i>\n" + prompt_text(request)
    keyboard = [[{"text": f"{i}. {label}", "callback_data": f"test:{i}"}] for i, (label, _) in enumerate(options, 1)]
    m = telegram("sendMessage", cfg["token"], chat_id=cfg["chat"], text=text, parse_mode="HTML",
                 reply_markup={"inline_keyboard": keyboard})
    print("Sent. Tap an option on your phone (waiting a minute)...")
    offset, deadline = None, time.time() + 60
    while time.time() < deadline:
        for u in telegram("getUpdates", cfg["token"], timeout=15, offset=offset, allowed_updates=["callback_query"]):
            offset = u["update_id"] + 1
            q = u.get("callback_query") or {}
            if (q.get("data") or "").startswith("test:"):
                pick = int(q["data"].split(":")[1])
                telegram("answerCallbackQuery", cfg["token"], callback_query_id=q["id"])
                edit(cfg["token"], cfg["chat"], {"message": m["message_id"], "text": text}, f"✓ {pick}. {options[pick - 1][0]}")
                print(f"You tapped: {options[pick - 1][0]}")
                return
    edit(cfg["token"], cfg["chat"], {"message": m["message_id"], "text": text}, "No answer")
    sys.exit("No tap came in.")


def main():
    a = sys.argv[1:]
    if not a or a[0] == "current":
        print(current() or "")
    elif a[0] == "list":
        cur = current()
        for n in names():
            if not os.path.exists(slot_path(n)):
                print(f"  {n}  (not signed in)")
                continue
            acct = read_json(slot_path(n)).get("oauthAccount") or {}
            print(f"{'*' if n == cur else ' '} {n}  {acct.get('emailAddress', '?')}  "
                  f"{acct.get('organizationName', '')}")
    elif a[0] == "init":
        init(a[1:])
    elif a[0] == "remove" and len(a) == 2:
        remove(a[1])
    elif a[0] == "rename" and len(a) == 3:
        rename(a[1], a[2])
    elif a[0] == "switch" and len(a) == 2:
        with locked():
            switch(a[1])
    elif a[0] == "usage":
        usage()
    elif a[0] == "limit-hit" and len(a) == 2:
        limit_hit(a[1])
    elif a[0] == "phone" and len(a) == 1:
        phone_setup()
    elif a[0] == "phone" and a[1] == "test":
        phone_test()
    elif a[0] == "phone" and a[1] == "run":
        phone_run()
    elif a[0] == "phone" and a[1] == "sleeping":
        phone_sleeping()
    elif a[0] in OPTION_OFF and len(a) <= 2:
        if len(a) == 2:
            if a[1] not in ("on", "off"):
                sys.exit(__doc__)
            set_option(a[0], a[1] == "on")
        print("on" if option(a[0]) else "off")
    elif a[0] == "history" and len(a) <= 2:
        history(a[1] if len(a) == 2 else None)
    elif a[0] == "add" and len(a) >= 2:
        add(a[1], "--current" in a, private="--private" in a)
        if "--switch" in a:
            with locked():
                switch(a[1])
            print(f"switched to {a[1]}")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
