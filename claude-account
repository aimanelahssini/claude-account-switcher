#!/usr/bin/env python3
"""Switch Claude Code between saved accounts by swapping ~/.claude/.credentials.json.

A running Claude Code session notices the credentials file changed (mtime) and
uses the new login on its next request, so the current chat just continues.

  claude-account init [NAMES]     save the current Claude Code login (as the first NAME, else "1")
  claude-account list             show accounts and which ones are signed in
  claude-account current          print the active account
  claude-account switch N         make account N active
  claude-account add N            sign in to account N in the browser
      --private                   ...in a private window, so the browser can't reuse another login
      --switch                    ...and switch to it afterwards
      --current                   save the account Claude Code is logged into now, no browser
  claude-account rename OLD NEW   rename an account (any name: 2, work, -, ...)
  claude-account remove N         forget account N's login
  claude-account usage            fetch 5-hour usage % for every account into accounts/usage.cache
  claude-account history [N]      recent 5-hour windows and how high each went
  claude-account auto-switch on|off   at 100% of the 5-hour limit, switch to the account
                                  with the most room left (on by default)
  claude-account keep-awake on|off    keep the computer awake while Claude works, lid closed
                                  too (claude-busy; on by default)
  claude-account ask on|off           permission prompts as notifications too (on by default)
  claude-account lights on|off        blink the ThinkPad lights (after install-lights.sh; on)
"""
import datetime, fcntl, json, os, shutil, subprocess, sys, tempfile, time, urllib.request

HOME = os.path.expanduser("~")
CLAUDE_DIR = os.path.join(HOME, ".claude")
CREDS = os.path.join(CLAUDE_DIR, ".credentials.json")
CONFIG = os.path.join(HOME, ".claude.json")
SLOTS = os.path.join(CLAUDE_DIR, "accounts")
ACTIVE = os.path.join(SLOTS, "active")
NAMES = os.path.join(SLOTS, "names")
REFRESH_LOCK = os.path.join(CLAUDE_DIR, ".oauth_refresh.lock")
USAGE_CACHE = os.path.join(SLOTS, "usage.cache")
# One JSON line per reading or switch: {"t", "a", "pct", "reset"} or {"t", "switch"}.
HISTORY = os.path.join(SLOTS, "history.jsonl")
HISTORY_DAYS = 30
HISTORY_EVERY = 600  # record an unchanged reading at most every 10 minutes
LOCK = os.path.join(SLOTS, ".lock")
# Options are on unless these files exist (the top bar's right-click menu toggles them).
OPTION_OFF = {"auto-switch": os.path.join(SLOTS, "auto-switch-off"),
              "keep-awake": os.path.join(SLOTS, "keep-awake-off"),
              "ask": os.path.join(SLOTS, "ask-off"),
              "lights": os.path.join(SLOTS, "lights-off")}
WINDOW_JITTER = 600  # the API's reset time wobbles by a second or so between readings
# Tokens per account (tokens.cache), from Claude Code's own transcripts on this computer, in 10-minute steps:
# {"step": 600, "accounts": {name: {step start: [tokens, cache reads]}}}. "tokens" is input +
# output + cache writes; cache reads are kept apart since they're cheap and huge.
TOKENS = os.path.join(SLOTS, "tokens.cache")  # not .json: those are accounts
TOKENS_STATE = os.path.join(SLOTS, ".tokens-state")  # how far each transcript was read
TOKENS_STEP = 600
TOKENS_DAYS = 8
PROJECTS = os.path.join(CLAUDE_DIR, "projects")
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"


def read_json(path):
    with open(path) as f:
        return json.load(f)


def write_json(path, data, mode=0o600):
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def slot_path(n):
    return os.path.join(SLOTS, f"{n}.json")


def slots():
    os.makedirs(SLOTS, mode=0o700, exist_ok=True)
    return sorted(f[:-5] for f in os.listdir(SLOTS) if f.endswith(".json") and not f.startswith("."))


def names():
    """Account names in display order: the names file, then any other saved slot."""
    try:
        listed = [l.strip() for l in open(NAMES) if l.strip()]
    except FileNotFoundError:
        listed = []
    return listed + [n for n in slots() if n not in listed]


def set_names(new):
    new = list(dict.fromkeys(new))  # no duplicates, order kept
    os.makedirs(SLOTS, mode=0o700, exist_ok=True)
    with open(NAMES + ".tmp", "w") as f:
        f.write("".join(f"{n}\n" for n in new))
    os.replace(NAMES + ".tmp", NAMES)


def current():
    try:
        return open(ACTIVE).read().strip() or None
    except FileNotFoundError:
        return None


def set_active(n):
    with open(ACTIVE + ".tmp", "w") as f:
        f.write(f"{n}\n")
    os.replace(ACTIVE + ".tmp", ACTIVE)


def save_live_into(n):
    """Store the live login (with any tokens Claude refreshed meanwhile) into slot n."""
    slot = read_json(slot_path(n)) if os.path.exists(slot_path(n)) else {}
    slot["credentials"] = read_json(CREDS)
    acct = read_json(CONFIG).get("oauthAccount")
    # Only take oauthAccount if it still belongs to this slot (a running session may not
    # have rewritten it yet after a switch).
    if acct and (not slot.get("oauthAccount") or
                 acct.get("accountUuid") == slot["oauthAccount"].get("accountUuid")):
        slot["oauthAccount"] = acct
    write_json(slot_path(n), slot)


def locked():
    os.makedirs(SLOTS, mode=0o700, exist_ok=True)
    f = open(LOCK, "w")
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


def http_json(url, data=None, token=None):
    headers = {"User-Agent": "claude-account", "Content-Type": "application/json"}
    if token:
        headers |= {"Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"}
    body = json.dumps(data).encode() if data is not None else None
    with urllib.request.urlopen(urllib.request.Request(url, body, headers), timeout=15) as r:
        return json.load(r)


def refresh_slot(n, slot):
    """Renew an inactive slot's expired access token (the live one is Claude's job)."""
    oauth = slot["credentials"]["claudeAiOauth"]
    r = http_json(TOKEN_URL, {"grant_type": "refresh_token", "client_id": CLIENT_ID,
                              "refresh_token": oauth["refreshToken"],
                              "scope": " ".join(oauth.get("scopes", []))})
    oauth["accessToken"] = r["access_token"]
    oauth["refreshToken"] = r.get("refresh_token", oauth["refreshToken"])
    oauth["expiresAt"] = int((time.time() + r["expires_in"]) * 1000)
    write_json(slot_path(n), slot)


def read_history():
    out = []
    try:
        with open(HISTORY) as f:
            for line in f:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    pass
    except FileNotFoundError:
        pass
    return out


def append_history(entries):
    if not entries:
        return
    with open(HISTORY, "a") as f:
        for e in entries:
            f.write(json.dumps(e, separators=(",", ":")) + "\n")
    if os.path.getsize(HISTORY) > 512 * 1024:  # prune now and then
        cutoff = time.time() - HISTORY_DAYS * 86400
        keep = [e for e in read_history() if e.get("t", 0) >= cutoff]
        tmp = HISTORY + ".tmp"
        with open(tmp, "w") as f:
            f.writelines(json.dumps(e, separators=(",", ":")) + "\n" for e in keep)
        os.replace(tmp, HISTORY)


def reset_time(reset):
    try:
        return datetime.datetime.fromisoformat(reset.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        return None


def same_window(a, b):
    ta, tb = reset_time(a), reset_time(b)
    return ta is not None and tb is not None and abs(ta - tb) < WINDOW_JITTER


def record_readings(out):
    """Add fresh readings to the history: on any change, else every HISTORY_EVERY seconds."""
    last = {}
    for e in read_history()[-200:]:
        if "a" in e:
            last[e["a"]] = e
    now = int(time.time())
    new = []
    for n, u in out.items():
        if n.startswith("_") or u.get("stale") or not isinstance(u.get("pct"), (int, float)):
            continue
        prev = last.get(n)
        if prev and prev.get("pct") == u["pct"] and same_window(prev.get("reset"), u.get("resets_at")) \
                and now - prev["t"] < HISTORY_EVERY:
            continue
        new.append({"t": now, "a": n, "pct": u["pct"], "reset": u.get("resets_at")})
    append_history(new)


def windows(name, days=7):
    """5-hour windows of one account, newest first: (start, end, peak %)."""
    cutoff = time.time() - days * 86400
    ends = sorted((reset_time(e.get("reset")), e["pct"]) for e in read_history()
                  if e.get("a") == name and e["t"] >= cutoff and reset_time(e.get("reset")))
    # Readings of one window are a second or so apart in reset time; windows are hours apart.
    groups = []
    for end, pct in ends:
        if groups and end - groups[-1][0] < WINDOW_JITTER:
            groups[-1][1] = max(groups[-1][1], pct)
        else:
            groups.append([end, pct])
    rounded = ((round(end / 60) * 60, peak) for end, peak in groups)
    return sorted(((end - 5 * 3600, end, peak) for end, peak in rounded), reverse=True)


def account_at(switches, t):
    """The account that was active at time t, from the switches in the history."""
    who = None
    for st, n in switches:
        if st > t:
            break
        who = n
    if who is None and not switches:
        who = current()
    return who


def index_tokens():
    """Add what Claude Code's transcripts gained since last time to tokens.cache."""
    try:
        state = read_json(TOKENS_STATE)
    except (FileNotFoundError, ValueError):
        state = {}
    try:
        data = read_json(TOKENS)
    except (FileNotFoundError, ValueError):
        data = {}
    files, seen = state.get("files", {}), state.get("seen", [])
    seen_set = set(seen)
    accounts = data.get("accounts", {})
    switches = [(e["t"], e["switch"]) for e in read_history() if "switch" in e]
    cutoff = time.time() - TOKENS_DAYS * 86400
    new_files = {}
    for root, _, names_ in os.walk(PROJECTS):
        for fn in names_:
            if not fn.endswith(".jsonl"):
                continue
            path = os.path.join(root, fn)
            try:
                st = os.stat(path)
            except OSError:
                continue
            if st.st_mtime < cutoff:
                continue
            offset, ino = files.get(path, [0, st.st_ino])
            if ino != st.st_ino or st.st_size < offset:
                offset = 0
            if st.st_size > offset:
                with open(path, "rb") as f:
                    f.seek(offset)
                    chunk = f.read(st.st_size - offset)
                end = chunk.rfind(b"\n") + 1  # a line still being written waits for next time
                for line in chunk[:end].splitlines():
                    if b'"usage"' not in line or b'"assistant"' not in line:
                        continue
                    try:
                        e = json.loads(line)
                        msg = e["message"]
                        u = msg["usage"]
                        t = datetime.datetime.fromisoformat(e["timestamp"].replace("Z", "+00:00")).timestamp()
                    except (ValueError, KeyError, TypeError, AttributeError):
                        continue
                    key = msg.get("id") or e.get("requestId")
                    if t < cutoff or not key or key in seen_set:
                        continue  # Claude Code writes one line per content block, same usage
                    seen_set.add(key)
                    seen.append(key)
                    who = account_at(switches, t)
                    if who is None:
                        continue
                    bucket = str(int(t // TOKENS_STEP * TOKENS_STEP))
                    slot = accounts.setdefault(who, {}).setdefault(bucket, [0, 0])
                    slot[0] += sum(u.get(k) or 0 for k in ("input_tokens", "output_tokens", "cache_creation_input_tokens"))
                    slot[1] += u.get("cache_read_input_tokens") or 0
                offset += end
            new_files[path] = [offset, st.st_ino]
    for buckets in accounts.values():
        for b in [b for b in buckets if int(b) < cutoff]:
            del buckets[b]
    write_json(TOKENS, {"step": TOKENS_STEP, "accounts": accounts}, mode=0o600)
    write_json(TOKENS_STATE, {"files": new_files, "seen": seen[-5000:]}, mode=0o600)
    return accounts


def tokens_between(accounts, name, start, end):
    return sum(v[0] for b, v in accounts.get(name, {}).items() if start <= int(b) < end)


def short(n):
    for div, unit in ((1e9, "B"), (1e6, "M"), (1e3, "k")):
        if n >= div:
            v = n / div
            return (f"{v:.1f}".rstrip("0").rstrip(".") if v < 10 else f"{v:.0f}") + unit
    return str(int(n))


def history(name=None):
    for n in ([name] if name else names()):
        print(f"{n}:")
        rows = windows(n)
        if not rows:
            print("  no history yet (it's recorded from the first usage check on)")
        try:
            accounts = read_json(TOKENS).get("accounts", {})
        except (FileNotFoundError, ValueError):
            accounts = {}
        for start, end, peak in rows[:10]:
            s, e = datetime.datetime.fromtimestamp(start), datetime.datetime.fromtimestamp(end)
            bar = "█" * round(peak / 10) + "·" * (10 - round(peak / 10))
            tokens = tokens_between(accounts, n, start, end)
            now = "  now" if start <= time.time() < end else ""
            print(f"  {s:%a %d %b %H:%M}–{e:%H:%M}  {bar} {peak:3.0f}%"
                  f"{f'  {short(tokens)} tokens' if tokens else ''}{now}")


def usage():
    cur = current()
    try:
        previous = read_json(USAGE_CACHE)
    except (FileNotFoundError, ValueError):
        previous = {}
    out = {}
    for n in slots():
        try:
            with locked():
                slot = read_json(slot_path(n))
                if n == cur:
                    oauth = read_json(CREDS)["claudeAiOauth"]
                    # Claude Code renews the live token itself on its next request; until
                    # then keep showing the last numbers rather than a failed lookup.
                    if oauth["expiresAt"] / 1000 < time.time() and previous.get(n, {}).get("pct") is not None:
                        out[n] = dict(previous[n], stale=True)
                        continue
                else:
                    oauth = slot["credentials"]["claudeAiOauth"]
                    if oauth["expiresAt"] / 1000 < time.time() + 60:
                        refresh_slot(n, slot)
                token = oauth["accessToken"]
            five = http_json(USAGE_URL, token=token).get("five_hour") or {}
            out[n] = {"pct": five.get("utilization"), "resets_at": five.get("resets_at")}
        except Exception as e:
            last = previous.get(n, {})
            out[n] = dict(last, stale=True, error=str(e)[:200]) if last.get("pct") is not None \
                else {"pct": None, "error": str(e)[:200]}
    out["_at"] = int(time.time())
    try:
        record_readings(out)
    except OSError:
        pass
    try:
        index_tokens()
    except OSError:
        pass
    with open(USAGE_CACHE + ".tmp", "w") as f:
        json.dump(out, f)
    os.replace(USAGE_CACHE + ".tmp", USAGE_CACHE)
    for n in slots():
        print(n, out[n].get("pct"), out[n].get("error", ""))
    if option("auto-switch"):
        auto_switch(cur, out)


def option(name):
    return not os.path.exists(OPTION_OFF[name])


def set_option(name, on):
    if on:
        try:
            os.remove(OPTION_OFF[name])
        except FileNotFoundError:
            pass
    else:
        open(OPTION_OFF[name], "w").close()


def auto_switch(cur, out):
    """The active account is at its 5-hour limit: move to the signed-in one with the most room."""
    now = time.time()
    u = out.get(cur) or {}
    if not isinstance(u.get("pct"), (int, float)) or u["pct"] < 100:
        return
    # A kept (stale) reading still counts while its window lasts.
    if u.get("stale") and (reset_time(u.get("resets_at")) or 0) < now:
        return
    room = [(out[n]["pct"], i, n) for i, n in enumerate(slots())
            if n != cur and isinstance(out.get(n, {}).get("pct"), (int, float))
            and not out[n].get("stale") and out[n]["pct"] < 100]
    if not room:
        return
    target = min(room)[2]
    with locked():
        if current() != cur:
            return
        switch(target, auto=True)
    print(f"auto-switched {cur} -> {target}")


def wait_for_refresh_lock():
    for _ in range(50):
        if not os.path.exists(REFRESH_LOCK):
            return
        time.sleep(0.2)


def switch(n, auto=False):
    if not os.path.exists(slot_path(n)):
        sys.exit(f"account {n} is not signed in; run: claude-account add {n}")
    cur = current()
    if cur == n:
        return
    wait_for_refresh_lock()
    if cur and os.path.exists(slot_path(cur)) and os.path.exists(CREDS):
        save_live_into(cur)
    target = read_json(slot_path(n))
    write_json(CREDS, target["credentials"])
    if target.get("oauthAccount"):
        cfg = read_json(CONFIG)
        cfg["oauthAccount"] = target["oauthAccount"]
        write_json(CONFIG, cfg, mode=os.stat(CONFIG).st_mode & 0o777)
    set_active(n)
    append_history([dict({"t": int(time.time()), "switch": n}, **({"auto": cur} if auto else {}))])


# Private-window flags for browsers, keyed by a word in their .desktop id.
PRIVATE_BROWSERS = [
    ("firefox", ["firefox", "--private-window"], "org.mozilla.firefox"),
    ("librewolf", ["librewolf", "--private-window"], "io.gitlab.librewolf-community"),
    ("chromium", ["chromium-browser", "--incognito"], "org.chromium.Chromium"),
    ("chrome", ["google-chrome", "--incognito"], "com.google.Chrome"),
    ("brave", ["brave-browser", "--incognito"], "com.brave.Browser"),
    ("edge", ["microsoft-edge", "--inprivate"], "com.microsoft.Edge"),
]


def private_browser():
    """Command that opens a URL in a private window of the default browser (or None)."""
    try:
        default = subprocess.run(["xdg-settings", "get", "default-web-browser"],
                                 capture_output=True, text=True).stdout.lower()
    except FileNotFoundError:
        default = ""
    ordered = sorted(PRIVATE_BROWSERS, key=lambda b: b[0] not in default)
    for _, cmd, flatpak_id in ordered:
        if shutil.which(cmd[0]):
            return cmd
        if shutil.which("flatpak") and subprocess.run(
                ["flatpak", "info", flatpak_id], capture_output=True).returncode == 0:
            return ["flatpak", "run", flatpak_id] + cmd[1:]
    return None


def add(n, use_current, private=False):
    slots()
    if n not in names():
        set_names(names() + [n])
    if use_current:
        write_json(slot_path(n), {"credentials": read_json(CREDS),
                                  "oauthAccount": read_json(CONFIG).get("oauthAccount")})
        set_active(n)
        print(f"saved the current login as account {n}")
        return
    tmp = tempfile.mkdtemp(prefix="claude-login-")
    try:
        env = dict(os.environ, CLAUDE_CONFIG_DIR=tmp)
        if private:
            cmd = private_browser()
            if cmd:
                opener = os.path.join(tmp, "open-private")
                with open(opener, "w") as f:
                    f.write("#!/bin/sh\nexec " + " ".join(cmd) + ' "$1"\n')
                os.chmod(opener, 0o700)
                env["BROWSER"] = opener
                print(f"Opening the sign-in page in a private window ({cmd[-2] if cmd[0] == 'flatpak' else cmd[0]})...", flush=True)
            else:
                print("No browser with a private mode found; using the normal browser.", flush=True)
        try:
            subprocess.run(["claude", "auth", "login"], env=env, check=True)
            creds = read_json(os.path.join(tmp, ".credentials.json"))
        except (subprocess.CalledProcessError, FileNotFoundError, KeyboardInterrupt):
            sys.exit("login not completed; nothing saved")
        acct = read_json(os.path.join(tmp, ".claude.json")).get("oauthAccount")
        write_json(slot_path(n), {"credentials": creds, "oauthAccount": acct})
        print(f"signed in as {acct and acct.get('emailAddress')}, saved as account {n}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def remove(n):
    if current() == n:
        sys.exit(f"{n} is the active account; switch to another one first")
    if os.path.exists(slot_path(n)):
        os.remove(slot_path(n))
    print(f"forgot the login for {n}")


def rename(old, new):
    if old not in names():
        sys.exit(f"no account named {old}")
    if new in names():
        sys.exit(f"there's already an account named {new}")
    if not new or "/" in new or new.startswith("."):
        sys.exit("pick a name without '/' that doesn't start with '.'")
    with locked():
        order = names()  # read before moving the file, or the moved login looks like an extra account
        if os.path.exists(slot_path(old)):
            os.replace(slot_path(old), slot_path(new))
        set_names([new if n == old else n for n in order])
        hist = read_history()
        if any(e.get("a") == old or e.get("switch") == old for e in hist):
            for e in hist:
                if e.get("a") == old:
                    e["a"] = new
                if e.get("switch") == old:
                    e["switch"] = new
            tmp = HISTORY + ".tmp"
            with open(tmp, "w") as f:
                f.writelines(json.dumps(e, separators=(",", ":")) + "\n" for e in hist)
            os.replace(tmp, HISTORY)
        if current() == old:
            set_active(new)
        try:
            cache = read_json(USAGE_CACHE)
            if old in cache:
                cache[new] = cache.pop(old)
                write_json(USAGE_CACHE, cache, mode=0o644)
        except (FileNotFoundError, ValueError):
            pass
    print(f"renamed {old} to {new}")


def init(new_names):
    """Installer entry point: names come from the user, so only the current login is saved."""
    if new_names and not os.path.exists(NAMES):
        set_names(new_names)
    if not slots() and os.path.exists(CREDS):
        add((names() or ["1"])[0], use_current=True)
    if names():
        print("accounts: " + "  ".join(names()))
    print("Add an account with the + in the top bar, or: claude-account add NAME --private")
    print("Rename one with: claude-account rename OLD NEW")


def main():
    a = sys.argv[1:]
    if not a or a[0] == "current":
        print(current() or "")
    elif a[0] == "list":
        cur = current()
        for n in names():
            if not os.path.exists(slot_path(n)):
                print(f"  {n}  (not signed in)")
                continue
            acct = read_json(slot_path(n)).get("oauthAccount") or {}
            print(f"{'*' if n == cur else ' '} {n}  {acct.get('emailAddress', '?')}  "
                  f"{acct.get('organizationName', '')}")
    elif a[0] == "init":
        init(a[1:])
    elif a[0] == "remove" and len(a) == 2:
        remove(a[1])
    elif a[0] == "rename" and len(a) == 3:
        rename(a[1], a[2])
    elif a[0] == "switch" and len(a) == 2:
        with locked():
            switch(a[1])
    elif a[0] == "usage":
        usage()
    elif a[0] in OPTION_OFF and len(a) <= 2:
        if len(a) == 2:
            if a[1] not in ("on", "off"):
                sys.exit(__doc__)
            set_option(a[0], a[1] == "on")
        print("on" if option(a[0]) else "off")
    elif a[0] == "history" and len(a) <= 2:
        history(a[1] if len(a) == 2 else None)
    elif a[0] == "add" and len(a) >= 2:
        add(a[1], "--current" in a, private="--private" in a)
        if "--switch" in a:
            with locked():
                switch(a[1])
            print(f"switched to {a[1]}")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
