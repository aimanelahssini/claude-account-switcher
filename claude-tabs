#!/usr/bin/python3 -I
"""Terminal windows and their tabs, in tab order, as JSON: [{"window": title, "tabs": [title, ...]}].

Read through the accessibility bus (AT-SPI), where GTK terminals like Ptyxis list each window's
tab pages by their titles. The top bar uses it to show Claude's chats in your tab order.
"""
import json
import sys

import gi
gi.require_version('Atspi', '2.0')
from gi.repository import Atspi

TERMINALS = ('ptyxis', 'gnome-terminal', 'kgx', 'console')


def tab_pages(node, out, depth=0):
    """A window's tab pages: the named panels, in order."""
    if depth > 16:
        return
    try:
        role, name = node.get_role_name(), node.get_name() or ''
    except Exception:
        return
    if role == 'panel' and name:
        out.append(name.strip())
        return
    try:
        count = node.get_child_count()
    except Exception:
        return
    for i in range(count):
        child = node.get_child_at_index(i)
        if child:
            tab_pages(child, out, depth + 1)


def main():
    windows = []
    desktop = Atspi.get_desktop(0)
    for i in range(desktop.get_child_count()):
        app = desktop.get_child_at_index(i)
        if not app or not any(t in (app.get_name() or '').lower() for t in TERMINALS):
            continue
        for j in range(app.get_child_count()):
            frame = app.get_child_at_index(j)
            if not frame:
                continue
            tabs = []
            tab_pages(frame, tabs)
            windows.append({'window': (frame.get_name() or '').strip(), 'tabs': tabs})
    json.dump(windows, sys.stdout, ensure_ascii=False)
    print()


if __name__ == '__main__':
    main()
